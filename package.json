{
  "name": "xrobot",
  "publisher": "XRobot",
  "displayName": "XRobot",
  "description": "VS Code extension for XRobot",
  "version": "2.0.1",
  "icon": "media/xrobot.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xrobot-org/xrobot-vscode-extension"
  },
  "homepage": "https://xrobot.work/",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:xrobot.helloWorld",
    "onCommand:xrobot.showPinLayout",
    "onView:xrobot.libxrView",
    "onView:xrobot.xrobotView"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the workspace's own values of xrobot.cli.extraPath, xrobot.cli.pythonPath, xrobot.libxr.sysconfigTool and xrobot.libxr.mspm0SdkDir are ignored, so the workspace cannot choose which programs the extension and the LibXR tools start.",
      "restrictedConfigurations": [
        "xrobot.cli.extraPath",
        "xrobot.cli.pythonPath",
        "xrobot.libxr.sysconfigTool",
        "xrobot.libxr.mspm0SdkDir"
      ]
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xrobot",
          "title": "XRobot",
          "icon": "media/xrobot.svg"
        }
      ]
    },
    "views": {
      "xrobot": [
        {
          "id": "xrobot.libxrView",
          "name": "LibXR"
        },
        {
          "id": "xrobot.xrobotView",
          "name": "XRobot"
        }
      ]
    },
    "commands": [
      {
        "command": "xrobot.helloWorld",
        "title": "XRobot: Hello World"
      },
      {
        "command": "xrobot.runCli",
        "title": "XRobot: Run CLI"
      },
      {
        "command": "xrobot.openFile",
        "title": "XRobot: Open File"
      },
      {
        "command": "xrobot.openUrl",
        "title": "XRobot: Open URL"
      },
      {
        "command": "xrobot.refreshAll",
        "title": "XRobot: Refresh All"
      },
      {
        "command": "xrobot.showPinLayout",
        "title": "XRobot: Show Pin Layout",
        "icon": "$(circuit-board)"
      },
      {
        "command": "xrobot.generateLibxrCode",
        "title": "XRobot: Generate LibXR Code",
        "icon": "$(play)"
      },
      {
        "command": "xrobot.openVendorTool",
        "title": "XRobot: Open in Vendor Tool"
      },
      {
        "command": "xrobot.collapseAllViews",
        "title": "XRobot: Collapse All Views"
      },
      {
        "command": "xrobot.pickLibxrConfigPath",
        "title": "XRobot: Pick LibXR Config Path"
      },
      {
        "command": "xrobot.pickLibxrAppMainPath",
        "title": "XRobot: Pick LibXR App Main Path"
      },
      {
        "command": "xrobot.selectProduct",
        "title": "XRobot: Select Product (xrobot gen -c)"
      },
      {
        "command": "xrobot.editYamlScalar",
        "title": "XRobot: Edit YAML Scalar"
      },
      {
        "command": "xrobot.createModuleWizard",
        "title": "XRobot: Create Module (xrobot new-module)"
      },
      {
        "command": "xrobot.addModuleInstance",
        "title": "XRobot: Add Module Instance"
      },
      {
        "command": "xrobot.editModuleInstance",
        "title": "XRobot: Edit Module Instance"
      },
      {
        "command": "xrobot.deleteModuleInstance",
        "title": "XRobot: Delete Module Instance"
      },
      {
        "command": "xrobot.addRepo",
        "title": "XRobot: Add Module Request"
      },
      {
        "command": "xrobot.editRepoVersion",
        "title": "XRobot: Change Module Request Ref"
      },
      {
        "command": "xrobot.deleteRepo",
        "title": "XRobot: Remove Module Request"
      },
      {
        "command": "xrobot.addSource",
        "title": "XRobot: Add Source"
      },
      {
        "command": "xrobot.editSourceUrl",
        "title": "XRobot: Edit Source URL"
      },
      {
        "command": "xrobot.editSourcePriority",
        "title": "XRobot: Edit Source Priority"
      },
      {
        "command": "xrobot.deleteSource",
        "title": "XRobot: Delete Source"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xrobot.runCli",
          "when": "false"
        },
        {
          "command": "xrobot.openFile",
          "when": "false"
        },
        {
          "command": "xrobot.openUrl",
          "when": "false"
        },
        {
          "command": "xrobot.editYamlScalar",
          "when": "false"
        },
        {
          "command": "xrobot.openVendorTool",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "xrobot.showPinLayout",
          "when": "view == xrobot.libxrView",
          "group": "navigation@1"
        },
        {
          "command": "xrobot.collapseAllViews",
          "when": "view == xrobot.libxrView || view == xrobot.xrobotView",
          "group": "navigation",
          "icon": "$(collapse-all)"
        }
      ],
      "view/item/context": [
        {
          "command": "xrobot.pickLibxrConfigPath",
          "when": "view == xrobot.libxrView && viewItem == xrobot.libxr.configPath",
          "group": "inline",
          "icon": "$(edit)"
        },
        {
          "command": "xrobot.pickLibxrAppMainPath",
          "when": "view == xrobot.libxrView && viewItem == xrobot.libxr.appMainPath",
          "group": "inline",
          "icon": "$(edit)"
        }
      ]
    },
    "configuration": {
      "title": "XRobot",
      "properties": {
        "xrobot.cli.extraPath": {
          "type": "string",
          "default": "",
          "description": "Additional directories (PATH syntax) appended to PATH when looking up and running the xrobot/LibXR CLIs."
        },
        "xrobot.cli.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter (name or full path) used to run the xrobot/LibXR Python modules when their console scripts are not on PATH. Leave empty to search PATH."
        },
        "xrobot.libxr.iocFile": {
          "type": "string",
          "default": "",
          "description": "Preferred STM32 .ioc file relative to workspace root. Leave empty to auto-detect first root-level *.ioc."
        },
        "xrobot.libxr.package": {
          "type": "string",
          "default": "",
          "description": "Overrides the package of the chip in the pin layout (for an MSPM0: LQFP-64, PM, VQFN-48, ...). Leave empty: an MSPM0 takes it from its SysConfig project (the .syscfg) and an STM32 from its model."
        },
        "xrobot.libxr.configPath": {
          "type": "string",
          "default": "User/libxr_config.yaml",
          "description": "Path to libxr_config.yaml relative to workspace root."
        },
        "xrobot.libxr.appMainPath": {
          "type": "string",
          "default": "User/app_main.cpp",
          "description": "Path to app_main.cpp relative to workspace root."
        },
        "xrobot.libxr.sysconfigTool": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path of the TI SysConfig command-line tool (SYSCONFIG_TOOL: sysconfig_cli.bat or sysconfig_cli.sh) for MSPM0 projects; libxr parse runs it, and Open in SysConfig starts the GUI of the same installation. Leave empty to use the environment variable."
        },
        "xrobot.libxr.mspm0SdkDir": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "MSPM0 SDK installation directory (MSPM0_SDK_INSTALL_DIR) for MSPM0 projects. Leave empty to use the environment variable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "mocha",
    "test:vscode": "npm run compile && vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "2.24.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
